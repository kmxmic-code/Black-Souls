 "version": "BETA",
 "notes": [
  {
   "v": "BETA",
   "date": "2026-11-01",
   "items": [
    "Launcher settings now live under \u2699 BKS Launcher at the bottom of the sidebar: check for launcher updates, create desktop shortcut",
    "The \u22ef menu next to PLAY is just for B.S.A.S: game updates, repair, game folder",
    "B.S.A.S has a new icon and new PixelLab key art on its launcher page"
   ]
  },
  {
   "v": "BETA",
   "date": "2026-11-01",
   "items": [
    "New name: B.S.A.S (Black Souls All Star)",
    "Full PixelLab overhaul: new fonts, HUD, menus, title, screens and logo",
    "14 stages with new PixelLab backdrops; new Al Namas, The Pit and desert road",
    "Rebuilt character select: RANDOM slot, smart colours, remembered picks, move list on SUPER, arcade join-in",
    "New wind-style hit effects; new Blitzy bullets, element pops, element hits and Elemental Cannon beam",
    "New cylinder HUD for Blitzy and a new rage bar for Big Rusty; cleaner HUD text",
    "Readable training panel; portraits fit their frames everywhere"
   ]
  },
  {
   "v": "BETA",
   "date": "2026-11-01",
   "items": [
    "The launcher is now called BKS and updates itself",
    "No more admin prompt when the launcher opens"
   ]
  },
  {
   "v": "BETA",
   "date": "2026-10-30",
   "items": [
    "Dodge is now on the DASH button: dash with no direction = spot dodge, forward = dash, back = back dash",
    "Dodge cooldown: 1 second, 1.5 seconds after escaping a combo, shown by a ring next to the meter",
    "True combos: dodge in a gap to escape a combo; long strings get less hitstun",
    "Matches show only the hit counter and dodge ring; Training shows damage, TRUE / BREAKABLE, escapes and frame gaps",
    "CPU fighters dodge out of combos and respect the cooldown",
    "Smooth animation: frames cross-fade (never on hits), toggle in Display settings",
    "New settings: Display, Audio, Gameplay, Controls, Accessibility, Online and Reset menus",
    "Balance pass: every fighter tuned toward a 50% win rate; select-screen stats updated"
   ]
  }
 ],
