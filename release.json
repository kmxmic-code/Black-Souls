{
 "version": "AFTER HOURS 0.1",
 "notes": [
  {
   "v": "AFTER HOURS 0.1",
   "date": "2026-11-07",
   "items": [
    "New game in the library: BKS After Hours, a five-night survival horror in a shut-down arcade",
    "Real 3D office and camera feeds - move the mouse to look around, flip cameras, mind the power",
    "Four mascots with their own habits: TILT, GLITCH, COIN and JACKPOT",
    "Five nights, saved progress and a Custom Night with aggression sliders",
    "Launcher v18: pick a game in the library, PLAY starts the selected one"
   ]
  },
  {
   "v": "TIMBERCLASH 1.0",
   "date": "2026-11-03",
   "items": [
    "Timberclash replaces B.S.A.S: a forest animal fighting tournament",
    "Fighters: Big Rusty, Blitzy and THYB",
    "4 maps: Bayou, Canyon, Shrine and Frost",
    "Tournament mode with a bracket and a trophy, plus Versus and Training",
    "CPU opponents at three levels: Cub, Scrapper and Champion",
    "New chiptune soundtrack, a theme for every map"
   ]
  }
 ],
